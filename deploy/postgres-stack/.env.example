# ============================================================================
#  Configuração da stack PostgreSQL própria (copie para .env e ajuste)
#  As chaves JWT (ANON_KEY / SERVICE_ROLE_KEY) são geradas pelo script
#  deploy/migrar-para-postgres.sh — não precisa preencher à mão.
# ============================================================================

# ----- domínio público onde a stack vai responder ---------------------------
PUBLIC_API_URL=https://api.zapmro.com.br
SITE_URL=https://zapmro.com.br
ADDITIONAL_REDIRECT_URLS=https://zapmro.com.br/**,https://www.zapmro.com.br/**,http://localhost:8080/**
GATEWAY_PORT=8000
PG_PORT=5432

# ----- segredos (gerados automaticamente se ficarem vazios) -----------------
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
REALTIME_ENC_KEY=
REALTIME_SECRET_KEY_BASE=

# ----- origem (Lovable Cloud) para o export/migração ------------------------
SUPABASE_URL=https://aossudsganqiapcoqthe.supabase.co
SUPABASE_PROJECT_REF=aossudsganqiapcoqthe
SUPABASE_SERVICE_ROLE_KEY=
SOURCE_DB_URL=

# ----- auth / email ---------------------------------------------------------
MAILER_AUTOCONFIRM=true
DISABLE_SIGNUP=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=

# ----- OAuth ----------------------------------------------------------------
GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_ENABLED=true
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ----- tuning ---------------------------------------------------------------
PG_MAX_CONNECTIONS=300
PG_SHARED_BUFFERS=512MB

# --- Cópia de segurança fora do servidor (Backblaze B2) ----------------------
# Rode sudo bash deploy/backup-b2-setup.sh depois de preencher estas 3 linhas.
# Sem elas o backup continua só no servidor, guardando 7 dias.
ZAPMRO_B2_ACCOUNT_ID=
ZAPMRO_B2_APPLICATION_KEY=
ZAPMRO_B2_BUCKET=
# ZAPMRO_B2_ENDPOINT=s3.us-west.backblazeb2.com   # descoberto pelo script de setup
# ZAPMRO_BACKUP_DIAS=2                            # dias guardados no servidor
# ZAPMRO_BACKUP_REMOTO_DIAS=14                    # dias de dump do banco no B2
# ZAPMRO_BACKUP_BWLIMIT=20M                       # limite de envio
PGRST_POOL=30
STORAGE_FILE_SIZE_LIMIT=524288000
